# Run `docker compose up -d db` or supply a managed PostgreSQL connection string.
DATABASE_URL=postgres://backseat:backseat@localhost:5432/backseat

# The backend origin registered with Twitch. In production WEB_ORIGIN should be identical.
APP_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=3000

# Register this exact redirect URI in the Twitch developer console:
# http://localhost:3000/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Generate distinct random values. Do not commit a populated .env file.
# SESSION_SECRET: at least 32 random characters.
# TOKEN_ENCRYPTION_KEY: base64-encoded 32 random bytes.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

